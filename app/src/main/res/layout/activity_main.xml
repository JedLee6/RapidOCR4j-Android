<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">




    <ScrollView
        android:id="@+id/scroll_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <Button
                    android:id="@+id/btn_select_image"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_select_image"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_take_photo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_take_photo" />
            </LinearLayout>

            <!-- 模型选择区域 -->
            <LinearLayout
                android:id="@+id/ll_model_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_select_recognition_models"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_model_list"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scrollbars="vertical" />

            </LinearLayout>

            <!-- 检测模型选择区域 -->
            <LinearLayout
                android:id="@+id/ll_det_model_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_select_detection_model"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rg_det_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_det_mobile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/det_model_mobile"
                        android:textSize="16sp"
                        android:tag="ch_PP-OCRv5_mobile_det.onnx"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rb_det_server"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/det_model_server"
                        android:textSize="16sp"
                        android:tag="ch_PP-OCRv5_server_det.onnx" />

                </RadioGroup>

            </LinearLayout>


            <!-- 文本显示控制区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:padding="12dp">

                <!-- 横向框合并控制区域 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="12dp"
                    android:elevation="2dp"
                    android:outlineProvider="background">

                    <!-- 横向框合并开关 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="横向框合并"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/sw_horizontal_merge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <!-- 合并阈值滑动条 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="垂直重叠度阈值"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_merge_threshold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.8"
                                android:textSize="14sp"
                                android:textColor="@android:color/holo_blue_dark"
                                android:paddingLeft="8dp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/sb_merge_threshold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="80" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="阈值说明：控制文本框合并的严格程度\n- 值越大（接近1.0）：合并条件更严格，只有高度重叠度高的框才会被合并\n- 值越小（接近0.0）：合并条件更宽松，更多相邻框会被合并为一个"
                            android:textSize="12sp"
                            android:textColor="@android:color/darker_gray"
                            android:paddingTop="8dp"
                            android:lineSpacingExtra="4sp" />
                    </LinearLayout>

                    <!-- 水平距离阈值滑动条 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="水平距离阈值"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_horizontal_distance_threshold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.2"
                                android:textSize="14sp"
                                android:textColor="@android:color/holo_blue_dark"
                                android:paddingLeft="8dp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/sb_horizontal_distance_threshold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="20" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="水平距离阈值说明：控制文本框水平相邻的判断条件\n- 值越大（接近1.0）：允许的水平间距越大，更多水平相邻框会被合并\n- 值越小（接近0.0）：允许的水平间距越小，只有非常接近的框才会被合并"
                            android:textSize="12sp"
                            android:textColor="@android:color/darker_gray"
                            android:paddingTop="8dp"
                            android:lineSpacingExtra="4sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 纵向框合并控制区域 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="12dp"
                    android:elevation="2dp"
                    android:outlineProvider="background">

                    <!-- 纵向框合并开关 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="纵向框合并"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/sw_vertical_merge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <!-- 句末终止分隔符开关 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="句末终止分隔符"
                            android:textSize="14sp" />

                        <Switch
                            android:id="@+id/sw_sentence_end_terminator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>
                    
                    <!-- 横向重叠度阈值滑动条 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="横向重叠度阈值（最大宽度百分比）"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_horizontal_overlap_threshold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.2"
                                android:textSize="14sp"
                                android:textColor="@android:color/holo_blue_dark"
                                android:paddingLeft="8dp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/sb_horizontal_overlap_threshold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="20" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="横向重叠度阈值说明：控制纵向框合并的横向重叠条件\n- 值越大（接近1.0）：要求的横向重叠越大，只有高度重叠的框才会被合并\n- 值越小（接近0.0）：允许的横向重叠越小，即使重叠较少的框也会被合并"
                            android:textSize="12sp"
                            android:textColor="@android:color/darker_gray"
                            android:paddingTop="8dp"
                            android:lineSpacingExtra="4sp" />
                    </LinearLayout>

                    <!-- 纵向距离阈值滑动条 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="纵向距离阈值（平均高度百分比）"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_vertical_distance_threshold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.25"
                                android:textSize="14sp"
                                android:textColor="@android:color/holo_blue_dark"
                                android:paddingLeft="8dp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/sb_vertical_distance_threshold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="800"
                            android:progress="225" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="纵向距离阈值说明：控制纵向框合并的距离条件
- 值越大（接近6.0）：允许的纵向间距越大，更多纵向相邻框会被合并
- 值越小（接近-2.0）：允许的纵向间距越小，甚至允许部分重叠的框不合并
- 负数表示允许框之间有部分重叠也可能不合并"
                            android:textSize="12sp"
                            android:textColor="@android:color/darker_gray"
                            android:paddingTop="8dp"
                            android:lineSpacingExtra="4sp" />
                    </LinearLayout>

                    <!-- 左侧位置差值阈值滑动条 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="左侧位置差值阈值（平均宽度百分比）"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_left_diff_threshold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.5"
                                android:textSize="14sp"
                                android:textColor="@android:color/holo_blue_dark"
                                android:paddingLeft="8dp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/sb_left_diff_threshold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="50" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="左侧位置差值阈值说明：控制纵向框合并的对齐条件\n- 值越大（接近1.0）：允许的左侧位置差值越大，更多不对齐的框会被合并\n- 值越小（接近0.0）：允许的左侧位置差值越小，只有对齐的框才会被合并"
                            android:textSize="12sp"
                            android:textColor="@android:color/darker_gray"
                            android:paddingTop="8dp"
                            android:lineSpacingExtra="4sp" />
                    </LinearLayout>

                    <!-- 下方框宽度百分比阈值滑动条 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="下方框宽度百分比阈值"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_bottom_width_ratio_threshold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.5"
                                android:textSize="14sp"
                                android:textColor="@android:color/holo_blue_dark"
                                android:paddingLeft="8dp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/sb_bottom_width_ratio_threshold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="50" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="下方框宽度百分比阈值说明：控制纵向框合并后的结束条件\n- 值越大（接近1.0）：要求下方框宽度占比越大才停止合并\n- 值越小（接近0.0）：允许下方框宽度占比越小就停止合并"
                            android:textSize="12sp"
                            android:textColor="@android:color/darker_gray"
                            android:paddingTop="8dp"
                            android:lineSpacingExtra="4sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 文本显示开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/text_show_floating_text"
                        android:textSize="16sp" />

                    <Switch
                        android:id="@+id/sw_text_visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <!-- 文本透明度滑块 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/text_text_opacity"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <SeekBar
                        android:id="@+id/sb_text_opacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/text_percentage_0"
                            android:textSize="14sp"
                            android:textColor="@android:color/darker_gray" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:text="@string/text_percentage_100"
                            android:textSize="14sp"
                            android:textColor="@android:color/darker_gray" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <hzkitty.android.ocr.OcrImageView
                android:id="@+id/iv_selected_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:scaleType="centerInside"
                tools:srcCompat="@tools:sample/avatars" />

            <!-- 智能合并文本开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_smart_merge"
                    android:textSize="16sp"
                    android:layout_marginEnd="16dp" />
                <Switch
                    android:id="@+id/sw_merge_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ocr_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:textIsSelectable="true"
                    tools:text="@string/ocr_result_placeholder" />

            <!-- 识别结果详细信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_recognition_box_details"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_rec_result"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:padding="8dp"/>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>